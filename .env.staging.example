# SyncOS staging template. Store real values in the hosting provider secret manager.
# Do not commit .env.staging with populated values.

NODE_ENV=staging
PORT=3000

# Public endpoints
WEB_BASE_URL=https://staging-app.synccommsystems.com
APPLICATION_BASE_URL=https://staging-app.synccommsystems.com
API_BASE_URL=https://staging-api.synccommsystems.com
PUBLIC_API_URL=https://staging-api.synccommsystems.com
SYNCOS_API_BASE_URL=https://staging-api.synccommsystems.com
NEXT_PUBLIC_API_BASE_URL=https://staging-api.synccommsystems.com
PUBLIC_WEBSITE_BASE_URL=https://synccommsystems.com
SYNCOS_ALLOWED_ORIGINS=https://staging-app.synccommsystems.com,https://synccommsystems.com,https://www.synccommsystems.com

# Database
DATABASE_URL=<set-in-provider-secret-manager>
DB_POOL_MAX=20
DB_SSL_REJECT_UNAUTHORIZED=true
WORKER_DB_POOL_MAX=5

# Redis / queues
REDIS_URL=<set-in-provider-secret-manager>

# Auth
AUTH_JWT_SECRET=<set-in-provider-secret-manager>
ALLOW_DEV_HEADER_AUTH=false
NEXT_PUBLIC_ALLOW_DEV_SESSION_PANEL=false

# Public inquiry and invite routing
PUBLIC_PARTNER_INQUIRY_TENANT_ID=<synthetic-staging-tenant-id>

# Email
EMAIL_PROVIDER=generic_http
EMAIL_HTTP_ENDPOINT=<set-in-provider-secret-manager>
EMAIL_API_KEY=<set-in-provider-secret-manager>
EMAIL_FROM=notifications@synccommsystems.com
EMAIL_REPLY_TO=info@synccommsystems.com
STAGING_EMAIL_RECIPIENT_ALLOWLIST=<operator-email@example.com,@syncos.test>

# Private storage
SYNCOS_RESTRICTED_FILE_STORAGE_DIR=<set-only-if-using-local-mounted-private-storage>
PRIVATE_STORAGE_PROVIDER=<provider-name>
PRIVATE_STORAGE_BUCKET=syncos-private-staging
PRIVATE_STORAGE_REGION=<region>
PRIVATE_STORAGE_ENDPOINT=<provider-endpoint>
PRIVATE_STORAGE_ACCESS_KEY_ID=<set-in-provider-secret-manager>
PRIVATE_STORAGE_SECRET_ACCESS_KEY=<set-in-provider-secret-manager>

# Field tolerances
SYNCOS_FIELD_SEQUENCE_VARIANCE_TOLERANCE_FT=25
SYNCOS_FIELD_COIL_VARIANCE_TOLERANCE_FT=5

# Worker schedules
SYNCOS_P6_EXPIRATION_SCAN_DISABLED=false
SYNCOS_P6_EXPIRATION_SCAN_INTERVAL_MS=300000
SYNCOS_P6_EXPIRATION_BATCH_SIZE=50
SYNCOS_P14_PERFORMANCE_SCAN_DISABLED=false
SYNCOS_P14_PERFORMANCE_SCAN_INTERVAL_MS=3600000
SYNCOS_P14_PERFORMANCE_BATCH_SIZE=50
SYNCOS_P15_MATCHING_SCAN_DISABLED=false
SYNCOS_P15_MATCHING_SCAN_INTERVAL_MS=3600000
SYNCOS_P15_MATCHING_BATCH_SIZE=50
SYNCOS_P16_COMMAND_SCAN_DISABLED=false
SYNCOS_P16_COMMAND_SCAN_INTERVAL_MS=3600000
SYNCOS_P16_COMMAND_BATCH_SIZE=25

# Payment safety
LIVE_AUTOMATED_PARTNER_PAYMENTS=false

# Staging synthetic seed gate
STAGING_SYNTHETIC_SEED_CONFIRM=false

# Observability
LOG_LEVEL=info
SENTRY_DSN=<optional-provider-secret>
OTEL_EXPORTER_OTLP_ENDPOINT=<optional-provider-secret>
